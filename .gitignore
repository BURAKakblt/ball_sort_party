# Secrets: never commit keys, credentials or local environment files
.env
.env.*
*.pem
*.p8
*.p12
*.mobileprovision
secrets/

# Firebase: never commit service accounts / admin keys or local tool output
*service-account*.json
*-firebase-adminsdk-*.json
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log
.firebase/
test-rules/node_modules/
